rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidFileItem(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'size', 'createdAt', 'updatedAt', 'starred', 'inTrash', 'ownerId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 255 &&
        data.type is string && data.type.size() <= 32 &&
        data.size is number &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.starred is bool &&
        data.inTrash is bool &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        (!('parentId' in data) || data.parentId == null || (data.parentId is string && data.parentId.size() <= 128)) &&
        (!('mimeType' in data) || data.mimeType == null || (data.mimeType is string && data.mimeType.size() <= 128)) &&
        (!('trashedAt' in data) || data.trashedAt == null || (data.trashedAt is string && data.trashedAt.size() <= 64)) &&
        (!('textData' in data) || data.textData == null || (data.textData is string && data.textData.size() <= 800000)) &&
        (!('dataUrl' in data) || data.dataUrl == null || (data.dataUrl is string && data.dataUrl.size() <= 800000));
    }

    // Connection testing doc
    match /test/{docId} {
      allow read: if true;
    }

    // Cloud storage files collection
    match /cloud_files/{fileId} {
      allow read: if true;
      allow create: if isValidId(fileId) && isValidFileItem(incoming());
      allow update: if isValidId(fileId) && isValidFileItem(incoming());
      allow delete: if isValidId(fileId);
    }

    // User profile documents
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);

      match /files/{fileId} {
        allow read: if true;
        allow create: if isValidId(fileId) && isValidFileItem(incoming());
        allow update: if isValidId(fileId) && isValidFileItem(incoming());
        allow delete: if isValidId(fileId);
      }
    }
  }
}
